#!/usr/bin/env bash
# talkytalky-doctor — look at the machine, pick the engine, write the config.
#
#   RAM < 8 GB, no dGPU              → moonshine            (tiny, ~100 MB)
#   RAM ≥ 8 GB, no dGPU, no AVX-512  → whisper base.en
#   RAM ≥ 8 GB, no dGPU, AVX-512     → whisper small.en
#   RAM ≥ 16 GB, no dGPU, AVX-512    → parakeet             (fast English on strong CPUs)
#   dGPU, VRAM < 4 GB                → whisper small.en     + GPU
#   dGPU, VRAM ≥ 4 GB                → whisper large-v3-turbo + GPU
#
# Only the block between `# >>> talkytalky:engine` and `# <<< talkytalky:engine`
# is rewritten; the rest of config.toml is yours.
set -euo pipefail

# shellcheck source=talkytalky-lib.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/talkytalky-lib.sh"

TT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
TEMPLATE="${TALKYTALKY_TEMPLATE:-$TT_CONFIG_DIR/config.toml.tmpl}"
[[ -r "$TEMPLATE" ]] || TEMPLATE="$TT_ROOT/config/config.toml.tmpl"

DRY_RUN=0 JSON=0 FORCE=0 DOWNLOAD=1 ASSUME_YES=0
for arg in "$@"; do
  case "$arg" in
    --dry-run)     DRY_RUN=1 ;;
    --json)        JSON=1 ;;
    --force)       FORCE=1 ;;
    --no-download) DOWNLOAD=0 ;;
    --recheck|-y|--yes) ASSUME_YES=1 ;;
    -h|--help)
      cat <<EOF
usage: talkytalky doctor [--dry-run] [--json] [--recheck] [--force] [--no-download]

  --dry-run      scan and show the recommendation, write nothing
  --json         machine-readable scan + recommendation
  --recheck      re-run after a hardware change; overwrite without asking
  --force        replace a config.toml that wasn't generated by talkytalky
  --no-download  skip 'voxtype setup --download' after writing the config
EOF
      exit 0 ;;
    *) tt_err "unknown flag: $arg"; exit 2 ;;
  esac
done

# ---- scan ------------------------------------------------------------------
# Every probe is overridable (TT_SCAN_*) so the decision table can be tested
# on a machine that doesn't have the hardware in question.

ram_gb="${TT_SCAN_RAM_GB:-}"
if [[ -z "$ram_gb" ]]; then
  ram_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
  ram_gb=$(( (ram_kb + 524288) / 1048576 ))
fi

cpu_model="${TT_SCAN_CPU:-$(sed -nE 's/^model name[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo 2>/dev/null | head -1)}"
cpu_model="${cpu_model:-unknown}"
cpu_threads="${TT_SCAN_THREADS:-$(nproc 2>/dev/null || echo 1)}"

avx512="${TT_SCAN_AVX512:-}"
if [[ -z "$avx512" ]]; then
  if grep -qw 'avx512f' /proc/cpuinfo 2>/dev/null; then avx512=1; else avx512=0; fi
fi

gpu_vendor="${TT_SCAN_GPU:-}"   # nvidia | amd | intel | none
gpu_name="${TT_SCAN_GPU_NAME:-}"
vram_mb="${TT_SCAN_VRAM_MB:-}"
if [[ -z "$gpu_vendor" ]]; then
  gpu_vendor=none
  if tt_have nvidia-smi && nvidia-smi --query-gpu=name,memory.total --format=csv,noheader,nounits >/dev/null 2>&1; then
    IFS=, read -r gpu_name vram_mb < <(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader,nounits | head -1)
    gpu_vendor=nvidia
  elif tt_have lspci; then
    pci="$(lspci 2>/dev/null | grep -Ei 'vga|3d|display' || true)"
    if grep -qi nvidia <<< "$pci"; then
      gpu_vendor=nvidia
    elif grep -qi 'intel' <<< "$pci"; then
      # "Corporation" contains the substring "ati", so Intel must be checked
      # before the AMD/ATI match below or every Intel iGPU misreads as AMD.
      if grep -qiE 'arc|dg[12]|battlemage|alchemist' <<< "$pci"; then gpu_vendor=intel; else gpu_vendor=intel-igpu; fi
    elif grep -qiE 'amd|radeon|\bati\b' <<< "$pci"; then
      # Discrete AMD parts show as "Navi"/"Radeon RX"; APUs say "Raphael"/"Rembrandt"/"Phoenix"/"Renoir"/"Cezanne".
      if grep -qiE 'raphael|rembrandt|phoenix|renoir|cezanne|picasso|raven|strix|granite ridge|vega [0-9]+ ?\(?mobile' <<< "$pci"; then
        gpu_vendor=amd-igpu
      else
        gpu_vendor=amd
      fi
    fi
    gpu_name="$(sed -E 's/^[^:]*: //; s/ \(rev [^)]*\)//' <<< "$pci" | head -1)"
  fi
  if [[ -z "$vram_mb" && "$gpu_vendor" == "amd" ]] && tt_have rocm-smi; then
    vram_mb="$(rocm-smi --showmeminfo vram --csv 2>/dev/null | awk -F, 'NR==2 {printf "%d", $2/1048576}')"
  fi
  if [[ -z "$vram_mb" && "$gpu_vendor" =~ ^(amd|intel)$ ]]; then
    for f in /sys/class/drm/card*/device/mem_info_vram_total; do
      [[ -r "$f" ]] && { vram_mb=$(( $(cat "$f") / 1048576 )); break; }
    done
  fi
fi
vram_mb="${vram_mb:-0}"
gpu_name="${gpu_name:-none}"

discrete=0
[[ "$gpu_vendor" =~ ^(nvidia|amd|intel)$ ]] && discrete=1

# ---- decide ----------------------------------------------------------------
engine=whisper model="" gpu_enable=0 reason=""
if (( discrete )); then
  gpu_enable=1
  if (( vram_mb >= 4096 || vram_mb == 0 )); then
    model="large-v3-turbo"; reason="discrete GPU with ${vram_mb:-?} MB VRAM — run the big model on it"
  else
    model="small.en"; reason="discrete GPU but under 4 GB VRAM — small.en fits comfortably"
  fi
elif (( ram_gb < 8 )); then
  engine=moonshine; model=""; reason="${ram_gb} GB RAM, no dGPU — moonshine keeps the footprint ~100 MB"
elif (( avx512 && ram_gb >= 16 )); then
  engine=parakeet; model="parakeet-tdt-0.6b-v3"; reason="${ram_gb} GB RAM + AVX-512 — parakeet is fast, accurate English on CPU"
elif (( avx512 )); then
  model="small.en"; reason="${ram_gb} GB RAM + AVX-512 — small.en stays realtime on CPU"
else
  model="base.en"; reason="${ram_gb} GB RAM, no AVX-512 — base.en is the safe CPU default"
fi

case "$engine" in
  whisper)
    block=$(cat <<EOF
engine = "whisper"

[whisper]
model = "$model"
language = "en"
on_demand_loading = true
$( (( gpu_enable )) && echo 'gpu_isolation = true' || echo "threads = $(( cpu_threads > 8 ? 8 : cpu_threads ))" )
EOF
) ;;
  parakeet)
    block=$(cat <<EOF
engine = "parakeet"

[parakeet]
model = "$model"
model_type = "tdt"
on_demand_loading = true
EOF
) ;;
  moonshine)
    block=$(cat <<EOF
engine = "moonshine"

[moonshine]
on_demand_loading = true
EOF
) ;;
esac

# ---- report ----------------------------------------------------------------
if (( JSON )); then
  printf '{"ram_gb":%d,"cpu":"%s","threads":%d,"avx512":%s,"gpu":"%s","gpu_name":"%s","vram_mb":%d,"discrete":%s,"engine":"%s","model":"%s","gpu_enable":%s,"reason":"%s"}\n' \
    "$ram_gb" "${cpu_model//\"/\\\"}" "$cpu_threads" "$([[ $avx512 == 1 ]] && echo true || echo false)" \
    "$gpu_vendor" "${gpu_name//\"/\\\"}" "$vram_mb" "$([[ $discrete == 1 ]] && echo true || echo false)" \
    "$engine" "$model" "$([[ $gpu_enable == 1 ]] && echo true || echo false)" "${reason//\"/\\\"}"
  exit 0
fi

tt_head "talkytalky doctor"
tt_kv "cpu"     "$cpu_model  ${C_DIM}(${cpu_threads} threads$( (( avx512 )) && printf ', avx-512'))"
tt_kv "ram"     "${ram_gb} GB"
tt_kv "gpu"     "$gpu_name  ${C_DIM}(${gpu_vendor}$( (( vram_mb )) && printf ', %d MB' "$vram_mb"))"
echo
tt_kv "engine"  "${C_ACCENT}${engine}${model:+ · $model}"
tt_kv "gpu"     "$( (( gpu_enable )) && echo enabled || echo off )"
tt_dim "  $reason"

if (( DRY_RUN )); then
  echo; tt_dim "  --dry-run: would write to $VOX_CONFIG_FILE"; echo
  printf '%s%s%s\n' "$C_DIM" "$block" "$C_RESET"
  exit 0
fi

# ---- write -----------------------------------------------------------------
mkdir -p "$VOX_CONFIG_DIR"
if [[ -f "$VOX_CONFIG_FILE" ]]; then
  if grep -q '# >>> talkytalky:engine' "$VOX_CONFIG_FILE"; then
    base="$VOX_CONFIG_FILE"
  elif (( FORCE )); then
    base="$TEMPLATE"
  else
    echo
    tt_warn "$VOX_CONFIG_FILE exists and wasn't generated by talkytalky."
    tt_warn "re-run with --force to replace it (a .bak copy is kept)."
    exit 1
  fi
  if (( ! ASSUME_YES )) && [[ -t 0 ]]; then
    echo
    printf '%s  write engine block to %s? [y/N] %s' "$C_FG" "$VOX_CONFIG_FILE" "$C_RESET"
    read -r ans; [[ "$ans" =~ ^[Yy] ]] || { tt_dim "  left as is."; exit 0; }
  fi
  cp -p "$VOX_CONFIG_FILE" "$VOX_CONFIG_FILE.bak.$(date +%Y%m%d%H%M%S)"
else
  base="$TEMPLATE"
fi

tmp="$(mktemp)"
awk -v block="$block" '
  /^# >>> talkytalky:engine/ { print; print block; skip=1; next }
  /^# <<< talkytalky:engine/ { skip=0 }
  !skip { print }
' "$base" > "$tmp"
mv "$tmp" "$VOX_CONFIG_FILE"
echo
tt_ok "wrote $VOX_CONFIG_FILE"

# ---- let voxtype finish the job ---------------------------------------------
if tt_have voxtype; then
  if (( gpu_enable )); then
    voxtype setup gpu --enable >/dev/null 2>&1 && tt_ok "gpu acceleration enabled" || tt_warn "voxtype setup gpu --enable failed — run it by hand"
  fi
  if (( DOWNLOAD )); then
    tt_dim "  downloading model…"
    voxtype setup --download && tt_ok "model ready" || tt_warn "download failed — run: voxtype setup --download"
  fi
  tt_dim "  restart the daemon to pick this up:  systemctl --user restart voxtype"
else
  tt_warn "voxtype not on PATH — install it, then: voxtype setup --download"
fi
