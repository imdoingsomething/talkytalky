# TalkyTalky — voxtype config
# Generated by `talkytalky doctor`. Edit freely; doctor only rewrites the
# block between the `talkytalky:engine` markers.

state_file = "auto"

# >>> talkytalky:engine
engine = "whisper"

[whisper]
model = "base.en"
language = "en"
on_demand_loading = true
# <<< talkytalky:engine

[hotkey]
# Hyprland's native bind/bindr handles push-to-talk — see config/hypr-talkytalky.conf
enabled = false

[audio]
device = "default"
sample_rate = 16000
max_duration_secs = 120
pause_media = true

[output]
mode = "type"
fallback_to_clipboard = true
paste_keys = "shift+insert"   # Hyprland/Omarchy universal paste
type_delay_ms = 0

[output.post_process]
# Logs every dictation to the Obsidian vault, then passes the text through unchanged.
command = "~/.local/bin/talkytalky-vault-log.sh"
timeout_ms = 5000

[output.notification]
on_recording_start = false
on_recording_stop = false
on_transcription = false      # the OSD is the feedback; keep the shell quiet

[text]
spoken_punctuation = true
replacements = { "talky talky" = "TalkyTalky", "vox type" = "voxtype" }

# ---- on-screen display: dark, moody ----------------------------------------
[osd]
frontend = "quickshell"
palette = "custom"
layout = "minimal"

[osd.frame]
background = "#0e0f13"
border = "state"
glow = true
halo = false

# Low, slow ember waveform on near-black. Nothing bright unless you're talking.
[[osd.visual.layers]]
type = "shadow"
color = "#000000"
opacity = 0.6
order = 0

[[osd.visual.layers]]
type = "background"
color = "#0e0f13"
opacity = 0.92
order = 1

[[osd.visual.layers]]
type = "waveform"
source = "rms"
color = "#7c6f9f"     # dusty violet
gain = 0.9
opacity = 0.55
mirror = true
order = 10

[[osd.visual.layers]]
type = "bars"
source = "peak"
color = "#b3413a"     # dried blood — only lights up on peaks
gain = 1.1
opacity = 0.85
mirror = true
order = 20

[[osd.visual.layers]]
type = "pulse"
source = "state"
color = "#7c6f9f"
opacity = 0.35
order = 30

[[osd.visual.layers]]
type = "icon"
source = "state"
color = "#c8c4bd"     # bone
order = 40

[status]
icon_theme = "dots"
